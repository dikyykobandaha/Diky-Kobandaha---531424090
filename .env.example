# ===========================================================================
# EventFlow - Environment Configuration
# Salin file ini ke .env dan sesuaikan nilai yang diperlukan.
# JANGAN commit file .env ke repositori.
# ===========================================================================

# Node environment: development | test | production
NODE_ENV=development

# Port backend API (Express)
PORT=3001

# Host backend
HOST=0.0.0.0

# Database MySQL (Prisma)
# Ganti user, password, hostname, dan nama database sesuai instalasi Anda.
# Contoh jika menggunakan Laragon MySQL default:
#   DATABASE_URL="mysql://root:@127.0.0.1:3306/eventflow"
DATABASE_URL=mysql://eventflow:eventflow@127.0.0.1:3306/eventflow

# Secret untuk session cookie (MINIMAL 32 karakter)
# Buat string acak panjang, misalnya di terminal:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-this-with-a-very-long-random-secret-min-32-chars

# Umur session dalam detik (default 7 hari)
SESSION_MAX_AGE_SECONDS=604800

# Origin frontend untuk CORS (development: Vite default port 5173)
CORS_ORIGIN=http://localhost:5173

# Frontend URL untuk generate link absolut (opsional)
FRONTEND_URL=http://localhost:5173

# Jendela rate limit (ms)
RATE_LIMIT_WINDOW_MS=60000

# Maksimal request per jendela
RATE_LIMIT_MAX_REQUESTS=100

# Zona waktu default aplikasi
DEFAULT_TIMEZONE=Asia/Jakarta

# Nonaktifkan CSRF hanya Untuk keperluan testing (false di production)
DISABLE_CSRF=false
